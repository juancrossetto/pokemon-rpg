// Pokemon-like RPG — ver dossier de diseño para el porqué de cada decisión.
// Efectividad de tipos NO vive acá: son 18 tipos fijos, se cachean como
// constante en código desde PokeAPI (prisma no es el lugar para eso).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Cuenta y economía ----------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  country         String // ISO-3166 alpha-2, define el segmento del ranking
  locale          String   @default("es")
  coins           Int      @default(0)
  energy          Int      @default(20)
  energyMax       Int      @default(20)
  energyUpdatedAt DateTime @default(now()) // para calcular regeneración sin cron
  createdAt       DateTime @default(now())

  // Ladder PvP (dossier fase 4). Rating Elo + récord; segmento del ranking PvP.
  pvpRating Int @default(1000)
  pvpWins   Int @default(0)
  pvpLosses Int @default(0)

  pokemon         PokemonInstance[]
  inventory       InventoryItem[]
  gymAttempts     GymAttempt[]
  gymRuns         GymRun[]
  badges          Badge[]
  listingsSold    MarketListing[]   @relation("Seller")
  listingsBought  MarketListing[]   @relation("Buyer")
  clanMembership  ClanMember?
  ledClan         Clan?             @relation("ClanLeader")
  battlesAsUser   BattleLog[]       @relation("BattleUser")
  battlesAsOpp    BattleLog[]       @relation("BattleOpponent")
  battleSessions  BattleSession[]
  pvpAsChallenger PvpMatch[]        @relation("PvpChallenger")
  pvpAsOpponent   PvpMatch[]        @relation("PvpOpponent")
}

// ---------- Datos de Pokémon (seed desde PokeAPI, ver scripts/seed) ----------

model Species {
  id            Int       @id // pokedex id, mismo que en PokeAPI
  name          String    @unique
  types         String[] // 1 o 2 tipos, ej. ["fire"] o ["grass", "poison"]
  baseHp        Int
  baseAttack    Int
  baseDefense   Int
  baseSpAtk     Int
  baseSpDef     Int
  baseSpeed     Int
  spriteUrl     String
  generation    Int
  captureRate   Int       @default(45) // 0-255, de PokeAPI — más alto = más fácil de atrapar
  evolvesFromId Int?
  evolvesFrom   Species?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo     Species[] @relation("Evolution")

  learnableMoves    SpeciesMove[]
  instances         PokemonInstance[]
  battleSessions    BattleSession[]
  gymPokemon        GymPokemon[]
  gymTrainerPokemon GymTrainerPokemon[]
}

enum MoveCategory {
  PHYSICAL
  SPECIAL
  STATUS
}

model Move {
  id         Int          @id // move id de PokeAPI
  name       String       @unique
  type       String
  category   MoveCategory
  power      Int? // null para movimientos de estado
  accuracy   Int? // null = nunca falla
  pp         Int
  priority   Int          @default(0)
  effectText String?

  learnableBy SpeciesMove[]
  knownBy     PokemonMove[]
}

model SpeciesMove {
  speciesId  Int
  moveId     Int
  learnLevel Int

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@id([speciesId, moveId])
}

// ---------- Pokémon de un jugador ----------

model PokemonInstance {
  id        String   @id @default(cuid())
  ownerId   String
  speciesId Int
  nickname  String?
  level     Int      @default(5)
  xp        Int      @default(0)
  currentHp Int
  isShiny   Boolean  @default(false)
  teamSlot  Int? // 1-6 = en equipo activo, null = en almacenamiento (PC)
  caughtAt  DateTime @default(now())

  // Puntos manuales por Pokémon — el diferenciador de diseño del proyecto.
  // Ver dossier: reemplaza EV/IV por progresión que controla el jugador.
  unspentPoints  Int @default(0)
  ptStrength     Int @default(0) // ataque
  ptSpeed        Int @default(0) // orden de turnos
  ptDexterity    Int @default(0) // defensa
  ptIntelligence Int @default(0) // desbloquea movimientos + xp
  ptConstitution Int @default(0) // HP

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species        Species         @relation(fields: [speciesId], references: [id])
  moves          PokemonMove[]
  listings       MarketListing[]
  battleSessions BattleSession[]

  @@unique([ownerId, teamSlot]) // dos Pokémon no pueden compartir slot. Postgres
  // trata cada NULL como distinto, así que el PC (teamSlot null) no se ve afectado.
  @@index([ownerId])
  @@index([speciesId])
}

model PokemonMove {
  pokemonInstanceId String
  moveId            Int
  slot              Int // 1-4
  currentPp         Int    @default(0) // se setea al aprender; 0 se trata como "lleno" hasta la 1ª batalla

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)
  move    Move            @relation(fields: [moveId], references: [id])

  @@id([pokemonInstanceId, slot])
}

// ---------- Gimnasios y medallas ----------

model Gym {
  id            String @id @default(cuid())
  order         Int    @unique // orden secuencial fijo, 1..N — desbloquea al tener la medalla del anterior
  name          String
  leaderName    String
  badgeName     String @default("") // nombre real de la medalla (ej. "Boulder Badge")
  type          String // tipo principal del líder — define el ícono/color de la medalla
  cooldownHours Int    @default(24) // solo aplica tras perder una batalla (no al abandonar la corrida)
  coinReward    Int    @default(100)

  team           GymPokemon[]
  trainers       GymTrainer[]
  runs           GymRun[]
  attempts       GymAttempt[]
  badges         Badge[]
  battleSessions BattleSession[]
  battleLogs     BattleLog[]
}

// Equipo fijo del líder — no es un PokemonInstance real (no evoluciona, no
// tiene puntos manuales), mismo criterio que el Pokémon salvaje efímero.
model GymPokemon {
  id        String @id @default(cuid())
  gymId     String
  speciesId Int
  level     Int
  slot      Int // orden en el equipo del líder, 1..N

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@unique([gymId, slot])
}

// Entrenadores subordinados que hay que vencer en orden antes de desbloquear
// al líder — genéricos (no personajes con nombre propio de los juegos
// oficiales), equipo más chico y débil que el del líder, mismo tipo temático.
model GymTrainer {
  id    String @id @default(cuid())
  gymId String
  slot  Int // orden dentro del gimnasio, 1..N, antes del líder
  name  String

  gym            Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  team           GymTrainerPokemon[]
  battleSessions BattleSession[]

  @@unique([gymId, slot])
}

model GymTrainerPokemon {
  id           String @id @default(cuid())
  gymTrainerId String
  speciesId    Int
  level        Int
  slot         Int

  gymTrainer GymTrainer @relation(fields: [gymTrainerId], references: [id], onDelete: Cascade)
  species    Species    @relation(fields: [speciesId], references: [id])

  @@unique([gymTrainerId, slot])
}

enum GymRunStatus {
  ACTIVE
  WON
  ABANDONED
}

// Un intento de gimnasio: agrupa la secuencia entrenadores→líder de una
// corrida. Si se abandona (botón de salida) o se pierde una batalla dentro
// de la corrida, se marca ABANDONED — la próxima vez se empieza desde el
// entrenador 1 de nuevo, no se retoma donde quedó.
model GymRun {
  id                  String       @id @default(cuid())
  userId              String
  gymId               String
  status              GymRunStatus @default(ACTIVE)
  clearedTrainerSlots Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  battleSessions BattleSession[]

  @@index([userId, gymId, status])
}

model GymAttempt {
  id          String   @id @default(cuid())
  userId      String
  gymId       String
  attemptedAt DateTime @default(now())
  won         Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([userId, gymId])
}

model Badge {
  id       String   @id @default(cuid())
  userId   String
  gymId    String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([userId, gymId])
}

enum StatusCondition {
  BURN
  PARALYSIS
  POISON
  SLEEP
}

// ---------- Economía: objetos y mercado ----------

enum ItemType {
  BERRY
  EVOLUTION_STONE
  POKEBALL
  POTION
}

model Item {
  id              String   @id @default(cuid())
  name            String   @unique
  type            ItemType
  effectText      String?
  buyPrice        Int
  catchMultiplier Float? // solo para type=POKEBALL (null = no aplica). Master Ball usa un valor
  // altísimo (255) para que la fórmula de captura dé siempre "atrapado".
  healAmount      Int? // solo para type=POTION (null = no aplica). Full Restore usa un valor
  // altísimo (9999) para que la curación quede siempre acotada al HP máximo.

  inventoryOf InventoryItem[]
}

model InventoryItem {
  userId   String
  itemId   String
  quantity Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

enum ListingKind {
  POKEMON
  ITEM
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

model MarketListing {
  id                String        @id @default(cuid())
  sellerId          String
  kind              ListingKind
  // Solo si kind = POKEMON. No es @unique: un Pokémon puede tener varias
  // publicaciones históricas (SOLD/CANCELLED/EXPIRED). La regla "una sola
  // ACTIVE por Pokémon" la garantiza el lock de fila del vendedor que toman
  // las transacciones del mercado — ver src/lib/db-locks.ts.
  pokemonInstanceId String?
  itemId            String? // solo si kind = ITEM
  quantity          Int? // solo si kind = ITEM
  price             Int
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  // Se setea al crear (ahora + TTL). Null solo en filas anteriores a la
  // feature — esas no expiran. La expiración es lazy: se barre al cargar
  // el mercado, no hay cron.
  expiresAt         DateTime?
  buyerId           String?
  soldAt            DateTime?
  // Null = el vendedor todavía no vio el desenlace (vendido / expirado). Se
  // usa para el contador de novedades de "Mis publicaciones": sin esto, una
  // publicación que vence se devuelve al PC en silencio.
  sellerSeenAt      DateTime?

  seller  User             @relation("Seller", fields: [sellerId], references: [id])
  buyer   User?            @relation("Buyer", fields: [buyerId], references: [id])
  pokemon PokemonInstance? @relation(fields: [pokemonInstanceId], references: [id])

  @@index([status, kind])
  @@index([pokemonInstanceId])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([status, expiresAt]) // barrido de vencidas
}

// ---------- Clanes ----------

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

model Clan {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   @unique // 3-5 caracteres, se muestra junto al nombre
  leaderId  String   @unique
  createdAt DateTime @default(now())

  leader  User         @relation("ClanLeader", fields: [leaderId], references: [id])
  members ClanMember[]
}

model ClanMember {
  userId   String   @id
  clanId   String
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

// ---------- Batallas (historial — el ranking se calcula a partir de esto) ----------

enum BattleKind {
  PVE_WILD
  PVE_GYM
  PVP
}

model BattleLog {
  id         String     @id @default(cuid())
  kind       BattleKind
  userId     String
  opponentId String? // null si es PVE
  gymId      String?
  userWon    Boolean
  createdAt  DateTime   @default(now())

  user     User  @relation("BattleUser", fields: [userId], references: [id], onDelete: Cascade)
  opponent User? @relation("BattleOpponent", fields: [opponentId], references: [id])
  gym      Gym?  @relation(fields: [gymId], references: [id])

  @@index([userId])
}

// Batalla PvE en curso — se resuelve turno a turno vía Server Actions.
// El Pokémon salvaje no es un PokemonInstance real, es efímero: su HP y
// movimientos viven solo acá mientras dura el combate.
enum BattleSessionStatus {
  ACTIVE
  WON
  LOST
  FLED
  CAUGHT
}

model BattleSession {
  id                String              @id @default(cuid())
  userId            String
  pokemonInstanceId String
  wildSpeciesId     Int
  wildLevel         Int
  wildCurrentHp     Int
  wildMaxHp         Int
  wildMoveIds       Int[]
  wildMovePp        Int[]               @default([]) // PP restante paralelo a wildMoveIds
  status            BattleSessionStatus @default(ACTIVE)
  log               String[]            @default([])
  participantIds    String[]            @default([]) // todos los Pokémon del jugador que pelearon en esta sesión (para repartir XP al terminar)
  pendingXp         Int                 @default(0) // XP acumulada de KOs previos en la misma sesión, pendiente de repartir al terminar
  gymId             String? // null = encuentro salvaje. Si tiene valor, wildSpecies/wildLevel/etc.
  // reflejan al oponente ACTUAL (entrenador subordinado o líder), no uno efímero random.
  gymRunId          String? // corrida de gimnasio a la que pertenece esta batalla (null = encuentro salvaje)
  gymTrainerId      String? // entrenador subordinado actual — null = está peleando contra el líder
  gymPokemonSlot    Int? // slot del equipo actual (del entrenador o del líder) que se está peleando
  // Estado de combate en sesión (se limpia al cambiar de Pokémon / fin de batalla).
  playerStatus      StatusCondition?
  wildStatus        StatusCondition?
  playerSleepTurns  Int                 @default(0)
  wildSleepTurns    Int                 @default(0)
  playerAtkStage    Int                 @default(0)
  playerDefStage    Int                 @default(0)
  playerSpeStage    Int                 @default(0)
  wildAtkStage      Int                 @default(0)
  wildDefStage      Int                 @default(0)
  wildSpeStage      Int                 @default(0)
  fleeAttempts      Int                 @default(0) // fallos de huida; sube la chance (Gen III)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemonInstance PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)
  wildSpecies     Species         @relation(fields: [wildSpeciesId], references: [id])
  gym             Gym?            @relation(fields: [gymId], references: [id])
  gymRun          GymRun?         @relation(fields: [gymRunId], references: [id])
  gymTrainer      GymTrainer?     @relation(fields: [gymTrainerId], references: [id])

  @@index([userId, status])
}

// ---------- PvP ----------

// Partido PvP ya resuelto (simulación server-authoritative). Guarda el
// resultado, la cadena de KOs para reconstruir la narrativa y los ratings
// antes/después de ambos lados para poder mostrar el delta.
model PvpMatch {
  id                     String   @id @default(cuid())
  challengerId           String
  opponentId             String
  winnerId               String // challengerId u opponentId
  challengerRatingBefore Int
  challengerRatingAfter  Int
  opponentRatingBefore   Int
  opponentRatingAfter    Int
  koLog                  String[] @default([]) // "ladoNombre>ladoNombre" por KO
  turns                  Int      @default(0)
  createdAt              DateTime @default(now())

  challenger User @relation("PvpChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("PvpOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, createdAt])
  @@index([opponentId, createdAt])
}
