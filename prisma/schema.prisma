// Pokemon-like RPG — ver dossier de diseño para el porqué de cada decisión.
// Efectividad de tipos NO vive acá: son 18 tipos fijos, se cachean como
// constante en código desde PokeAPI (prisma no es el lugar para eso).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Cuenta y economía ----------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  country         String // ISO-3166 alpha-2, define el segmento del ranking
  locale          String    @default("es")
  gender          String? // "male" | "female" | "unspecified", opcional — puro perfil, sin efecto en mecánicas
  age             Int? // opcional
  avatarId        String? // referencia a AVATAR_OPTIONS en src/lib/avatars.ts, no una imagen — null = iniciales (comportamiento actual)
  /// Banner de home/perfil — id de HOME_BANNER_OPTIONS (`src/lib/home-banners.ts`). null = default.
  homeBannerId    String?
  /// Marco del banner de home — id de HOME_FRAME_OPTIONS (`src/lib/home-frames.ts`). null = default.
  homeFrameId     String?
  coins           Int       @default(0)
  /// Moneda premium (gemas) — reservada para usos de PC / economía especial.
  gems            Int       @default(0)
  /// Moneda de la Fábrica de Combate; se gana con las rachas diarias.
  factoryPoints   Int       @default(0)
  energy          Int       @default(30)
  energyMax       Int       @default(30)
  energyUpdatedAt DateTime  @default(now()) // para calcular regeneración sin cron
  lastHealAt      DateTime? // Centro Pokémon: la curación gratis tiene cooldown; pagar lo saltea
  /// Presencia social: heartbeat mientras hay sesión. Null = nunca visto online.
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())

  // Ladder PvP (dossier fase 4). Rating Elo + récord; segmento del ranking PvP.
  pvpRating Int @default(1000)
  pvpWins   Int @default(0)
  pvpLosses Int @default(0)

  pokemon            PokemonInstance[]
  inventory          InventoryItem[]
  gymAttempts        GymAttempt[]
  gymRuns            GymRun[]
  badges             Badge[]
  listingsSold       MarketListing[]      @relation("Seller")
  listingsBought     MarketListing[]      @relation("Buyer")
  marketWatches      MarketWatch[]
  pushSubscriptions  PushSubscription[]
  seasonRewardClaims SeasonRewardClaim[]
  clanMembership     ClanMember?
  ledClan            Clan?                @relation("ClanLeader")
  battlesAsUser      BattleLog[]          @relation("BattleUser")
  battlesAsOpp       BattleLog[]          @relation("BattleOpponent")
  battleSessions     BattleSession[]
  pvpAsChallenger    PvpMatch[]           @relation("PvpChallenger")
  pvpAsOpponent      PvpMatch[]           @relation("PvpOpponent")
  pvpSeasonStats     PvpSeasonStats[]
  pvpBattleSessions  BattleSession[]      @relation("PvpOpponentUser")
  campaignProgress   CampaignProgress?
  eggs               Egg[]
  clanMessages       ClanMessage[]
  notifications      Notification[]
  pokedexEntries     PokedexEntry[]
  zoneMastery        ZoneMastery[]
  seenSpecies        SeenSpecies[]
  trainerDefeats     TrainerDefeat[]
  objectiveClaims    ZoneObjectiveClaim[]
  dailyRewardClaims  DailyRewardClaim[]
  weeklyRewardClaims WeeklyRewardClaim[]
  eventMissionClaims EventMissionClaim[]
  achievementClaims  AchievementClaim[]
  rewardLedger       RewardLedger[]
  friendshipsAsA     Friendship[]         @relation("FriendshipA")
  friendshipsAsB     Friendship[]         @relation("FriendshipB")
  friendRequestsFrom FriendRequest[]      @relation("FriendRequestFrom")
  friendRequestsTo   FriendRequest[]      @relation("FriendRequestTo")
  blocksInitiated    UserBlock[]          @relation("Blocker")
  blocksReceived     UserBlock[]          @relation("Blocked")
  /// Cooldown tras abandonar un clan (anti hop).
  lastClanLeftAt     DateTime?
  clanApplications   ClanApplication[]
  clanInvitesFrom    ClanInvite[]         @relation("ClanInviteFrom")
  clanInvitesTo      ClanInvite[]         @relation("ClanInviteTo")
  towerProgress      TowerProgress[]
  towerRuns          TowerRun[]
  towerAttemptDays   TowerAttemptDay[]
  safariRuns         SafariRun[]
  clanWarBattlesA    ClanWarBattle[]      @relation("ClanWarFighterA")
  clanWarBattlesB    ClanWarBattle[]      @relation("ClanWarFighterB")
  weeklyRaidScores   WeeklyRaidScore[]
  factoryRuns        FactoryRun[]
  daycareDeposits    DaycareDeposit[]
  wonderOffers       WonderTradeOffer[]
  berryPlots         BerryPlot[]
  parkMine           ParkMine?
  parkCorner         ParkCorner?
  parkFishing        ParkFishing?
  parkWonder         ParkWonder?
  frontierAttempts   FrontierAttempt[]
  speciesFragments   SpeciesFragment[]
  friendTradesFrom   FriendTradeOffer[]   @relation("FriendTradeFrom")
  friendTradesTo     FriendTradeOffer[]   @relation("FriendTradeTo")
}

// ---------- Notificaciones in-app ----------
// Historial de avisos (mercado, gimnasios, PvP). El payload es JSON tipado
// por `type` — la UI traduce con next-intl, no se guardan strings localizados.

enum NotificationType {
  MARKET_SOLD
  MARKET_EXPIRED
  MARKET_WATCH
  GYM_WON
  GYM_LOST
  GYM_TM_REWARD
  PVP_WON
  PVP_LOST
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  CLAN_INVITE
  CLAN_APPLICATION
  CLAN_ACCEPTED
  CLAN_KICKED
  CLAN_ROLE_CHANGED
  DAILY_REWARD_READY
  ENERGY_FULL
  FRIEND_TRADE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// Datos para interpolar el mensaje (buyerName, itemName, coins, gymName…).
  payload   Json             @default("{}")
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Muestra de Core Web Vitals. Se guarda fuera del camino de respuesta y con
/// muestreo: todos los valores problemáticos, sólo una fracción de los buenos.
model WebVitalSample {
  id             String   @id @default(cuid())
  metricId       String
  name           String
  value          Float
  delta          Float
  rating         String
  navigationType String
  pathname       String
  viewport       String
  createdAt      DateTime @default(now())

  @@index([name, createdAt])
  @@index([pathname, createdAt])
  @@index([rating, createdAt])
}

// ---------- Progresión de campaña (Region → Location → Stage) ----------
// Contenido estático en src/lib/campaign/; acá solo el progreso del jugador.
// PvP no lee ni escribe este modelo.

model CampaignProgress {
  userId                    String   @id
  currentRegionId           String   @default("kanto")
  highestUnlockedLocationId String
  selectedLocationId        String
  farmingLocationId         String
  farmingStageId            String
  highestCompletedStageId   String?
  completedStageIds         String[] @default([])
  /**
   * Victorias/capturas parciales por stageId mientras no se completa (clearsRequired > 1).
   */
  stageClearCounts          Json     @default("{}")
  lastMilestoneId           String?
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Datos de Pokémon (seed desde PokeAPI, ver scripts/seed) ----------

model Species {
  id             Int       @id // pokedex id, mismo que en PokeAPI
  name           String    @unique
  types          String[] // 1 o 2 tipos, ej. ["fire"] o ["grass", "poison"]
  baseHp         Int
  baseAttack     Int
  baseDefense    Int
  baseSpAtk      Int
  baseSpDef      Int
  baseSpeed      Int
  spriteUrl      String
  generation     Int
  captureRate    Int       @default(45) // 0-255, de PokeAPI — más alto = más fácil de atrapar
  // Nivel mínimo para evolucionar por level-up a evolvesTo[0]. Null = no evoluciona por nivel
  // (piedra, intercambio, etc.) o es la forma final.
  evolveLevel    Int?
  // Cómo se llega a ESTA especie desde su pre-evolución. Vive del lado del hijo
  // porque el padre puede tener varias evoluciones con requisitos distintos
  // (Eevee → Vaporeon/Jolteon/Flareon, una piedra cada una) y `evolveLevel`,
  // que vive en el padre, no puede representarlas.
  evolveTrigger  String? // "level-up" | "use-item" | "trade" | "shed" ...
  evolveItem     String? // nombre del ítem tal cual está en `Item.name`, ej. "Water Stone"
  evolveMinLevel Int? // nivel mínimo del trigger, cuando aplica
  evolvesFromId  Int?
  evolvesFrom    Species?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo      Species[] @relation("Evolution")

  learnableMoves    SpeciesMove[]
  instances         PokemonInstance[]
  battleSessions    BattleSession[]
  gymPokemon        GymPokemon[]
  gymTrainerPokemon GymTrainerPokemon[]
  eggs              Egg[]
  pokedexEntries    PokedexEntry[]
  seenBy            SeenSpecies[]
  safariEncounters  SafariRun[]         @relation("SafariEncounterSpecies")
  safariBestRuns    SafariRun[]         @relation("SafariBestSpecies")
  safariCatches     SafariCatch[]
  fragments         SpeciesFragment[]
}

enum MoveCategory {
  PHYSICAL
  SPECIAL
  STATUS
}

model Move {
  id         Int          @id // move id de PokeAPI
  name       String       @unique
  type       String
  category   MoveCategory
  power      Int? // null para movimientos de estado
  accuracy   Int? // null = nunca falla
  pp         Int
  priority   Int          @default(0)
  effectText String?
  /**
   * PokeAPI move.target.name — selected-pokemon, all-opponents,
   * all-other-pokemon, user, etc. Default = single-target clásico.
   */
  target     String       @default("selected-pokemon")

  learnableBy SpeciesMove[]
  knownBy     PokemonMove[]
  teachableAs Item[] // MTs/MOs que enseñan este movimiento (type=MACHINE)
}

enum LearnMethod {
  LEVEL_UP
  MACHINE
}

// Compatibilidad real especie↔movimiento — un mismo par puede existir dos
// veces con method distinto (aprende por nivel Y por MT), como en los
// juegos reales. learnLevel solo tiene sentido para LEVEL_UP.
model SpeciesMove {
  speciesId  Int
  moveId     Int
  method     LearnMethod @default(LEVEL_UP)
  /**
   * Null en MT/tutor/huevo: esos movimientos no se aprenden por nivel.
   */
  learnLevel Int?

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@id([speciesId, moveId, method])
}

// ---------- Pokémon de un jugador ----------

model PokemonInstance {
  id            String   @id @default(cuid())
  ownerId       String
  speciesId     Int
  nickname      String?
  level         Int      @default(5)
  xp            Int      @default(0)
  currentHp     Int
  isShiny       Boolean  @default(false)
  teamSlot      Int? // 1-6 = en equipo activo, null = en almacenamiento (PC)
  /// Equipo PvP (1-6). Independiente del teamSlot de aventura; null = no está en preset.
  pvpSlot       Int?
  /// Destacado del entrenador (emblema de ranking); independiente del slot.
  isFavorite    Boolean  @default(false)
  /// Si true, no se puede publicar en el mercado.
  isTradeLocked Boolean  @default(false)
  caughtAt      DateTime @default(now())

  // Puntos manuales por Pokémon — el diferenciador de diseño del proyecto.
  // Ver dossier: reemplaza EV/IV por progresión que controla el jugador.
  unspentPoints  Int @default(0)
  ptStrength     Int @default(0) // ataque
  ptSpeed        Int @default(0) // orden de turnos
  ptDexterity    Int @default(0) // defensa
  ptIntelligence Int @default(0) // Sp. Atk y Sp. Def
  ptConstitution Int @default(0) // HP

  // Objeto equipado (Leftovers, Choice Band, etc.) — efecto real en batalla,
  // no decorativo. Ver Item.heldEffect/heldValue.
  heldItemId String?
  heldItem   Item?   @relation(fields: [heldItemId], references: [id])

  /// Movimientos LEVEL_UP que el jugador rechazó: no se vuelven a ofrecer.
  declinedMoveIds Int[] @default([])

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species          Species           @relation(fields: [speciesId], references: [id])
  moves            PokemonMove[]
  listings         MarketListing[]
  battleSessions   BattleSession[]   @relation("BattlePlayerA")
  battleSessionsB  BattleSession[]   @relation("BattlePlayerB")
  safariCatch      SafariCatch?
  daycareDeposit   DaycareDeposit?
  wonderOffer      WonderTradeOffer?
  friendTradeOffer FriendTradeOffer?

  @@unique([ownerId, teamSlot]) // dos Pokémon no pueden compartir slot. Postgres
  // trata cada NULL como distinto, así que el PC (teamSlot null) no se ve afectado.
  @@unique([ownerId, pvpSlot])
  @@index([ownerId])
  @@index([speciesId])
  @@index([ownerId, isFavorite])
  @@index([ownerId, pvpSlot])
  @@index([ownerId, caughtAt])
  @@index([ownerId, isShiny, caughtAt])
}

/// Entrada de Pokédex: el entrenador vio la especie (encuentro, batalla, etc.).
/// Capturado se deriva de PokemonInstance — no se duplica acá.
model PokedexEntry {
  userId    String
  speciesId Int
  seenAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([userId, speciesId])
  @@index([userId, seenAt])
}

// Cría: dos padres del jugador producen un huevo que hereda parte de los puntos
// invertidos. Es un sumidero de economía y le da uso a los que no pelean.
model Egg {
  id             String    @id @default(cuid())
  ownerId        String
  speciesId      Int
  parentAId      String
  parentBId      String
  /**
   * Puntos heredados que arranca la cría — mismos 5 atributos que la instancia.
   */
  ptStrength     Int       @default(0)
  ptSpeed        Int       @default(0)
  ptDexterity    Int       @default(0)
  ptIntelligence Int       @default(0)
  ptConstitution Int       @default(0)
  isShiny        Boolean   @default(false)
  readyAt        DateTime // eclosiona con el tiempo, como la energía: sin cron
  hatchedAt      DateTime?
  createdAt      DateTime  @default(now())

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@index([ownerId, hatchedAt])
}

model PokemonMove {
  pokemonInstanceId String
  moveId            Int
  slot              Int // 1-4
  currentPp         Int    @default(0) // 0 = agotado. Al aprender se setea al max PP del move.

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)
  move    Move            @relation(fields: [moveId], references: [id])

  @@id([pokemonInstanceId, slot])
}

// ---------- Gimnasios y medallas ----------

model Gym {
  id            String  @id @default(cuid())
  /**
   * Liga a la que pertenece (`kanto`, `johto`, …). El `order` reinicia en 1
   * por región — desbloqueo y Alto Mando son locales a la liga.
   */
  regionId      String  @default("kanto")
  order         Int // 1..N dentro de la región — desbloquea al tener la medalla del anterior
  name          String
  leaderName    String
  badgeName     String  @default("") // nombre real de la medalla (ej. "Boulder Badge")
  type          String // tipo principal del líder — define el ícono/color de la medalla
  cooldownHours Int     @default(4) // solo aplica tras perder una batalla (no al abandonar la corrida)
  opensHour     Int     @default(0) // horario de atención en hora local del jugador (0-23).
  closesHour    Int     @default(24) // 0/24 = abierto siempre. Si closes <= opens, cruza la medianoche.
  coinReward    Int     @default(100)
  /**
   * Alto Mando / Campeón: no cuenta como medalla y solo se abre con las N
   * medallas de la misma región (`badgeTarget`).
   */
  isElite       Boolean @default(false)

  team           GymPokemon[]
  trainers       GymTrainer[]
  runs           GymRun[]
  attempts       GymAttempt[]
  badges         Badge[]
  battleSessions BattleSession[]
  battleLogs     BattleLog[]

  @@unique([regionId, order])
  @@index([regionId])
}

// Equipo fijo del líder — no es un PokemonInstance real (no evoluciona, no
// tiene puntos manuales), mismo criterio que el Pokémon salvaje efímero.
model GymPokemon {
  id        String @id @default(cuid())
  gymId     String
  speciesId Int
  level     Int
  slot      Int // orden en el equipo del líder, 1..N

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@unique([gymId, slot])
}

// Entrenadores subordinados que hay que vencer en orden antes de desbloquear
// al líder — genéricos (no personajes con nombre propio de los juegos
// oficiales), equipo más chico y débil que el del líder, mismo tipo temático.
model GymTrainer {
  id    String @id @default(cuid())
  gymId String
  slot  Int // orden dentro del gimnasio, 1..N, antes del líder
  name  String

  gym            Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  team           GymTrainerPokemon[]
  battleSessions BattleSession[]

  @@unique([gymId, slot])
}

model GymTrainerPokemon {
  id           String @id @default(cuid())
  gymTrainerId String
  speciesId    Int
  level        Int
  slot         Int

  gymTrainer GymTrainer @relation(fields: [gymTrainerId], references: [id], onDelete: Cascade)
  species    Species    @relation(fields: [speciesId], references: [id])

  @@unique([gymTrainerId, slot])
}

enum GymRunStatus {
  ACTIVE
  WON
  ABANDONED
}

// Un intento de gimnasio: agrupa la secuencia entrenadores→líder de una
// corrida. Si se abandona (botón de salida) o se pierde una batalla dentro
// de la corrida, se marca ABANDONED — la próxima vez se empieza desde el
// entrenador 1 de nuevo, no se retoma donde quedó.
model GymRun {
  id                  String       @id @default(cuid())
  userId              String
  gymId               String
  status              GymRunStatus @default(ACTIVE)
  clearedTrainerSlots Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  battleSessions BattleSession[]

  @@index([userId, gymId, status])
}

model GymAttempt {
  id          String   @id @default(cuid())
  userId      String
  gymId       String
  attemptedAt DateTime @default(now())
  won         Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([userId, gymId])
  @@index([userId, won, attemptedAt])
}

model Badge {
  id       String   @id @default(cuid())
  userId   String
  gymId    String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([userId, gymId])
}

enum StatusCondition {
  BURN
  PARALYSIS
  POISON
  SLEEP
  FREEZE
}

// ---------- Economía: objetos y mercado ----------

enum ItemType {
  BERRY
  EVOLUTION_STONE
  POKEBALL
  POTION
  MACHINE
  HELD
}

// Efecto mecánico real de un objeto equipable en batalla — mismo criterio
// que SpeciesMove.method: el dato vive en el ítem, no se hardcodea por nombre.
enum HeldEffect {
  LEFTOVERS // cura heldValue% del HP máx al final del propio turno
  CHOICE_LOCK // heldValue× a heldStat, bloquea el movimiento tras el primer uso
  LIFE_ORB // +heldValue% de poder, retroceso 10% HP máx en golpes que dañan
  FOCUS_SASH // sobrevive con 1 HP un golpe que lo KOtearía desde HP máximo (un solo uso)
  EVIOLITE // +heldValue% def/def.esp si la especie no evolucionó del todo
  FLINCH_CHANCE // heldValue de probabilidad de que el rival no pueda moverse ese turno
  QUICK_CLAW // heldValue de probabilidad de actuar primero (misma prioridad)
  SITRUS_BERRY // cura heldValue% del HP máx una vez, al cruzar 50% HP (un solo uso)
  LUM_BERRY // cura cualquier estado alterado apenas se aplica (un solo uso)
  TYPE_BOOST // +heldValue% de poder en movimientos de tipo heldBoostType
  /// Holder fuera de pelea cobra heldValue de la EXP de la victoria (p. ej. 0.5).
  EXP_SHARE
}

model Item {
  id              String      @id @default(cuid())
  name            String      @unique
  type            ItemType
  effectText      String?
  buyPrice        Int
  /// Precio en gemas (moneda premium). Null = no se vende por gemas.
  /// Un ítem puede tener los dos precios; la tienda muestra el que aplique.
  gemPrice        Int?
  catchMultiplier Float? // solo para type=POKEBALL (null = no aplica). Master Ball usa un valor
  // altísimo (255) para que la fórmula de captura dé siempre "atrapado".
  healAmount      Int? // solo para type=POTION (null = no aplica). Full Restore usa un valor
  // altísimo (9999) para que la curación quede siempre acotada al HP máximo.
  moveId          Int? // solo para type=MACHINE (null = no aplica) — el movimiento que enseña
  move            Move?       @relation(fields: [moveId], references: [id])
  heldEffect      HeldEffect? // objeto equipable con efecto real en batalla (no aplica a todos los tipos)
  heldValue       Float? // magnitud genérica: multiplicador, % de HP o probabilidad según heldEffect
  heldStat        String? // "atk" | "spAtk" | "speed" — solo CHOICE_LOCK
  heldBoostType   String? // tipo de movimiento potenciado — solo TYPE_BOOST

  inventoryOf      InventoryItem[]
  holders          PokemonInstance[]
  battleWildHeldBy BattleSession[]   @relation("BattleWildHeldItem")
  berryPlots       BerryPlot[]
}

model InventoryItem {
  userId   String
  itemId   String
  quantity Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

enum ListingKind {
  POKEMON
  ITEM
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

model MarketListing {
  id                String        @id @default(cuid())
  sellerId          String
  kind              ListingKind
  // Solo si kind = POKEMON. No es @unique: un Pokémon puede tener varias
  // publicaciones históricas (SOLD/CANCELLED/EXPIRED). La regla "una sola
  // ACTIVE por Pokémon" la garantiza el lock de fila del vendedor que toman
  // las transacciones del mercado — ver src/lib/db-locks.ts.
  pokemonInstanceId String?
  itemId            String? // solo si kind = ITEM
  quantity          Int? // solo si kind = ITEM
  price             Int
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  // Se setea al crear (ahora + TTL). Null solo en filas anteriores a la
  // feature — esas no expiran. La expiración es lazy: se barre al cargar
  // el mercado, no hay cron.
  expiresAt         DateTime?
  buyerId           String?
  soldAt            DateTime?
  // Null = el vendedor todavía no vio el desenlace (vendido / expirado). Se
  // usa para el contador de novedades de "Mis publicaciones": sin esto, una
  // publicación que vence se devuelve al PC en silencio.
  sellerSeenAt      DateTime?
  // Null = el comprador todavía no retiró el bien de la mochila del mercado.
  // Hasta reclamar: ítems no entran al inventario; Pokémon quedan en escrow
  // del comprador (ocultos del PC).
  buyerClaimedAt    DateTime?

  seller  User             @relation("Seller", fields: [sellerId], references: [id])
  buyer   User?            @relation("Buyer", fields: [buyerId], references: [id])
  pokemon PokemonInstance? @relation(fields: [pokemonInstanceId], references: [id])

  @@index([status, kind])
  @@index([pokemonInstanceId])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([buyerId, status, buyerClaimedAt])
  @@index([status, expiresAt]) // barrido de vencidas
}

/// Alerta persistente por especie u objeto. `targetKey` evita duplicados aun
/// cuando el objetivo use una FK nullable (Postgres permite varios NULL).
model MarketWatch {
  id          String      @id @default(cuid())
  userId      String
  targetKey   String
  kind        ListingKind
  label       String
  targetPrice Int
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetKey])
  @@index([targetKey, targetPrice])
  @@index([userId, createdAt])
}

/// Suscripción Web Push del navegador. Un usuario puede instalar la PWA en
/// varios dispositivos; `endpoint` identifica cada instalación.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Amigos (grafo social) ----------
// Friendship canónica: userAId < userBId lexicográfico para evitar duplicados.
// Favoritos y presencia son por-usuario / derivados — no hay "estado Discord".

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model FriendRequest {
  id          String              @id @default(cuid())
  fromUserId  String
  toUserId    String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Friendship {
  id           String   @id @default(cuid())
  userAId      String
  userBId      String
  createdAt    DateTime @default(now())
  /// Favorito marcado por A (el dueño de userAId).
  favoriteForA Boolean  @default(false)
  /// Favorito marcado por B.
  favoriteForB Boolean  @default(false)

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---------- Clanes ----------

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

enum ClanJoinPolicy {
  OPEN
  REQUEST
  INVITE
}

enum ClanFocus {
  CASUAL
  COMPETITIVE
  PVE
  PVP
  COLLECTION
  EVENTS
  SOCIAL
  MIXED
}

/// Afinidad cosmética / misiones temáticas — no bonus PvP.
enum ClanAffinity {
  NORMAL
  FIRE
  WATER
  GRASS
  ELECTRIC
  ICE
  ROCK
  GROUND
  PSYCHIC
  DARK
  STEEL
  DRAGON
  FAIRY
  FIGHTING
  GHOST
}

enum ClanApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model Clan {
  id             String         @id @default(cuid())
  name           String         @unique
  /// Nombre en minúsculas sin acentos para unicidad laxa.
  normalizedName String         @unique
  tag            String         @unique // 2-5 caracteres, se muestra junto al nombre
  normalizedTag  String         @unique
  leaderId       String         @unique
  description    String? // hasta ~280
  motto          String?
  announcement   String?
  joinPolicy     ClanJoinPolicy @default(OPEN)
  focus          ClanFocus      @default(MIXED)
  affinity       ClanAffinity   @default(NORMAL)
  /// Locale preferido del clan (es/en/pt…); null = sin filtro.
  language       String?
  minPlayerLevel Int?
  /// Emblema configurado (shape/symbol/colors) — ver src/lib/clan-emblem.ts
  emblem         Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leader           User                  @relation("ClanLeader", fields: [leaderId], references: [id])
  members          ClanMember[]
  messages         ClanMessage[]
  applications     ClanApplication[]
  invites          ClanInvite[]
  warRegistrations ClanWarRegistration[]
  warsAsA          ClanWar[]             @relation("ClanWarA")
  warsAsB          ClanWar[]             @relation("ClanWarB")
}

model ClanMember {
  userId   String   @id
  clanId   String
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

model ClanMessage {
  id        String   @id @default(cuid())
  clanId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
}

model ClanApplication {
  id          String                @id @default(cuid())
  clanId      String
  userId      String
  message     String?
  status      ClanApplicationStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  respondedAt DateTime?

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([userId, status])
  @@index([clanId, status])
}

model ClanInvite {
  id          String                @id @default(cuid())
  clanId      String
  fromUserId  String
  toUserId    String
  status      ClanApplicationStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  respondedAt DateTime?

  clan     Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  fromUser User @relation("ClanInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ClanInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([clanId, toUserId])
  @@index([toUserId, status])
}

/**
 * Experiencia del jugador en una zona concreta.
 * Es lo que hace que volver a una zona ya completada siga teniendo sentido:
 * sube con cada victoria salvaje ahí y otorga bonus permanentes de XP, captura
 * y monedas en esa zona.
 */
model ZoneMastery {
  userId     String
  locationId String
  xp         Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
}

/**
 * Qué especies vio el jugador en cada zona.
 * Habilita el descubrimiento progresivo: la Pokédex de la zona arranca en
 * silueta desconocida y se va revelando al cruzarse cada especie, en vez de
 * mostrar de entrada todo lo que puede aparecer.
 */
model SeenSpecies {
  userId     String
  locationId String
  speciesId  Int
  seenAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@id([userId, locationId, speciesId])
  @@index([userId, locationId])
}

/**
 * A qué entrenadores de ruta ya venciste. Los entrenadores son estáticos.
 */
model TrainerDefeat {
  userId     String
  trainerId  String
  locationId String
  defeatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, trainerId])
  @@index([userId, locationId])
}

/**
 * Recompensas de objetivo de zona ya cobradas.
 */
model ZoneObjectiveClaim {
  userId     String
  locationId String
  objective  String // stages | pokedex | trainers — ver objectives.ts
  claimedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationId, objective])
  @@index([userId])
  @@index([userId, claimedAt])
}

// ---------- Batallas (historial — el ranking se calcula a partir de esto) ----------

enum BattleKind {
  PVE_WILD
  PVE_GYM
  PVE_TOWER
  PVP
}

model BattleLog {
  id         String     @id @default(cuid())
  kind       BattleKind
  userId     String
  opponentId String? // null si es PVE
  gymId      String?
  userWon    Boolean
  createdAt  DateTime   @default(now())

  user     User  @relation("BattleUser", fields: [userId], references: [id], onDelete: Cascade)
  opponent User? @relation("BattleOpponent", fields: [opponentId], references: [id])
  gym      Gym?  @relation(fields: [gymId], references: [id])

  @@index([userId])
  @@index([userId, userWon, createdAt])
}

// Batalla PvE en curso — se resuelve turno a turno vía Server Actions.
// El Pokémon salvaje no es un PokemonInstance real, es efímero: su HP y
// movimientos viven solo acá mientras dura el combate.
enum BattleSessionStatus {
  ACTIVE
  WON
  LOST
  FLED
  CAUGHT
}

/**
 * SINGLE = 1v1 (default). DOUBLE = 2v2 en campo (Torre elite MVP).
 */
enum BattleFormat {
  SINGLE
  DOUBLE
}

model BattleSession {
  id                     String              @id @default(cuid())
  userId                 String
  pokemonInstanceId      String
  /// Segundo activo del jugador en dobles (null en singles o slot vacío).
  pokemonInstanceBId     String?
  wildSpeciesId          Int
  wildLevel              Int
  wildCurrentHp          Int
  wildMaxHp              Int
  wildMoveIds            Int[]
  wildMovePp             Int[]               @default([]) // PP restante paralelo a wildMoveIds
  wildIsShiny            Boolean             @default(false)
  routeTrainerId         String? // entrenador de ruta (datos estáticos, ver trainers.ts) // se tira al generar el encuentro para que se vea variante en combate
  status                 BattleSessionStatus @default(ACTIVE)
  format                 BattleFormat        @default(SINGLE)
  /// Slot B del rival + estado de combate del slot B del jugador (dobles).
  /// Shape: DoublesFieldB en src/lib/doubles/field-b.ts. Null en singles.
  fieldB                 Json?
  log                    String[]            @default([])
  participantIds         String[]            @default([]) // todos los Pokémon del jugador que pelearon en esta sesión (para repartir XP al terminar)
  pendingXp              Int                 @default(0) // XP acumulada de KOs previos en la misma sesión, pendiente de repartir al terminar
  gymId                  String? // null = encuentro salvaje. Si tiene valor, wildSpecies/wildLevel/etc.
  // reflejan al oponente ACTUAL (entrenador subordinado o líder), no uno efímero random.
  gymRunId               String? // corrida de gimnasio a la que pertenece esta batalla (null = encuentro salvaje)
  gymTrainerId           String? // entrenador subordinado actual — null = está peleando contra el líder
  gymPokemonSlot         Int? // slot del equipo actual (del entrenador o del líder) que se está peleando
  towerRunId             String? // intento de Torre de Combate (null = no es torre)
  /// Incursión semanal: clave de semana del intento (null = no es incursión).
  /// Se guarda en la sesión y no se recalcula al cerrar para que un combate
  /// que cruza el reinicio del domingo acredite el daño a la semana en la que
  /// empezó, y no a la siguiente.
  raidWeekKey            String?
  /// Turnos que le quedan al intento de incursión. Al llegar a 0 se cierra y
  /// se acredita el daño acumulado (`wildMaxHp - wildCurrentHp`).
  raidTurnsLeft          Int?
  // Estado de combate en sesión (se limpia al cambiar de Pokémon / fin de batalla).
  playerStatus           StatusCondition?
  wildStatus             StatusCondition?
  playerSleepTurns       Int                 @default(0)
  wildSleepTurns         Int                 @default(0)
  playerAtkStage         Int                 @default(0)
  playerDefStage         Int                 @default(0)
  playerSpaStage         Int                 @default(0)
  playerSpdStage         Int                 @default(0)
  playerSpeStage         Int                 @default(0)
  playerAccStage         Int                 @default(0)
  playerEvaStage         Int                 @default(0)
  wildAtkStage           Int                 @default(0)
  wildDefStage           Int                 @default(0)
  wildSpaStage           Int                 @default(0)
  wildSpdStage           Int                 @default(0)
  wildSpeStage           Int                 @default(0)
  wildAccStage           Int                 @default(0)
  wildEvaStage           Int                 @default(0)
  fleeAttempts           Int                 @default(0) // fallos de huida; sube la chance (Gen III)
  /// Límite absoluto para que el jugador elija la próxima acción. Si vence, derrota por inactividad.
  turnDeadlineAt         DateTime?
  // Objeto equipado del jugador (fijo para toda la batalla, no se puede
  // cambiar en combate — ver blockIfInCombat en equip-held-item).
  playerChoiceLockMoveId Int? // si porta un objeto CHOICE_LOCK, el movimiento al que quedó atado
  playerItemConsumed     Boolean             @default(false) // FOCUS_SASH/SITRUS/LUM ya se gastaron esta batalla
  // Paridad PvP: el rival también puede traer objeto equipado (foto de sesión).
  wildHeldItemId         String?
  wildItemConsumed       Boolean             @default(false)
  wildChoiceLockMoveId   Int?
  // Movimientos de 2 turnos (Fly/Dig/Solar Beam…): el id del move mientras
  // está cargando / en el aire. Se limpia al ejecutar el 2º turno, al
  // cambiar de Pokémon o si un status le impide actuar.
  playerChargeMoveId     Int?
  wildChargeMoveId       Int?
  // PvP interactivo: sesión ligada a un PvpMatch ACTIVE.
  pvpMatchId             String?
  opponentUserId         String?
  opponentSlot           Int? // slot 1-6 del snapshot del rival que está en campo
  /// Guerra de clan: sesión ligada a un ClanWarBattle IN_PROGRESS.
  clanWarBattleId        String?             @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemonInstance  PokemonInstance  @relation("BattlePlayerA", fields: [pokemonInstanceId], references: [id], onDelete: Cascade)
  pokemonInstanceB PokemonInstance? @relation("BattlePlayerB", fields: [pokemonInstanceBId], references: [id], onDelete: SetNull)
  wildSpecies      Species          @relation(fields: [wildSpeciesId], references: [id])
  gym              Gym?             @relation(fields: [gymId], references: [id])
  gymRun           GymRun?          @relation(fields: [gymRunId], references: [id])
  gymTrainer       GymTrainer?      @relation(fields: [gymTrainerId], references: [id])
  towerRun         TowerRun?        @relation(fields: [towerRunId], references: [id], onDelete: SetNull)
  pvpMatch         PvpMatch?        @relation(fields: [pvpMatchId], references: [id], onDelete: SetNull)
  opponentUser     User?            @relation("PvpOpponentUser", fields: [opponentUserId], references: [id], onDelete: SetNull)
  wildHeldItem     Item?            @relation("BattleWildHeldItem", fields: [wildHeldItemId], references: [id], onDelete: SetNull)
  clanWarBattle    ClanWarBattle?   @relation(fields: [clanWarBattleId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([pvpMatchId])
  @@index([towerRunId])
  @@index([clanWarBattleId])
}

// ---------- PvP ----------

enum PvpMatchMode {
  RANKED
  QUICK
}

enum PvpMatchStatus {
  ACTIVE
  COMPLETED
  FORFEIT
}

// Partido PvP. RANKED se juega turno a turno (BattleSession); QUICK se
// resuelve al instante con el simulador. Guarda snapshots de ambos equipos
// para que el combate no dependa de la colección actual del rival.
model PvpMatch {
  id                     String         @id @default(cuid())
  challengerId           String
  opponentId             String
  mode                   PvpMatchMode   @default(QUICK)
  status                 PvpMatchStatus @default(COMPLETED)
  seasonKey              String?
  winnerId               String? // null mientras ACTIVE
  challengerRatingBefore Int
  challengerRatingAfter  Int?
  opponentRatingBefore   Int
  opponentRatingAfter    Int?
  /// Foto congelada del equipo del challenger (JSON tipado en código).
  challengerTeam         Json           @default("[]")
  /// Foto congelada del equipo del opponent.
  opponentTeam           Json           @default("[]")
  koLog                  String[]       @default([]) // "ladoNombre>ladoNombre" por KO
  turnLog                String[]       @default([]) // narrativa turno a turno
  turns                  Int            @default(0)
  coinsAwarded           Int            @default(0)
  createdAt              DateTime       @default(now())
  completedAt            DateTime?

  challenger     User            @relation("PvpChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent       User            @relation("PvpOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  battleSessions BattleSession[]

  @@index([challengerId, createdAt])
  @@index([opponentId, createdAt])
  @@index([status, createdAt])
  @@index([seasonKey])
}

/// Snapshot de rating/récord al cerrar (o al migrar) una temporada PvP.
model PvpSeasonStats {
  id        String   @id @default(cuid())
  userId    String
  seasonKey String
  rating    Int
  wins      Int      @default(0)
  losses    Int      @default(0)
  tier      String // bronze | silver | gold | platinum | diamond | master
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonKey])
  @@index([seasonKey, rating])
}

// ---------- Eventos y recompensas recurrentes ----------
// El catálogo (ciclo diario, desafíos semanales, eventos y sus misiones) vive
// en `src/lib/events/` como configuración tipada, igual que la campaña: acá
// solo se guarda el progreso del jugador. Así un evento nuevo no necesita
// migración ni panel de administración.

/// Un reclamo del regalo diario. Doble candado a propósito:
/// la PK impide reclamar dos veces la misma posición del ciclo, y el único
/// sobre `dayKey` impide reclamar dos veces el mismo día UTC —dos pestañas,
/// doble click o un reintento de red terminan en el mismo error del índice.
model DailyRewardClaim {
  userId    String
  cycleId   String
  dayIndex  Int // posición dentro del ciclo (1..cycleLength)
  dayKey    String // fecha UTC "YYYY-MM-DD" del reclamo
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cycleId, dayIndex])
  @@unique([userId, dayKey])
  @@index([userId, claimedAt])
}

/// Hito semanal cobrado. `weekKey` es la semana ISO en UTC ("2026-W31").
model WeeklyRewardClaim {
  userId    String
  weekKey   String
  milestone Int // porcentaje del objetivo: 20 | 40 | 60 | 80 | 100
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekKey, milestone])
  @@index([userId, claimedAt])
}

/// Recompensa de una misión de evento ya cobrada.
model EventMissionClaim {
  userId    String
  eventCode String
  missionId String
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventCode, missionId])
  @@index([userId, claimedAt])
}

/// Hito cobrado del pase mensual general. El progreso se deriva de actividad
/// real; sólo se persiste el candado idempotente de cada recompensa.
model SeasonRewardClaim {
  userId    String
  seasonKey String
  milestone Int
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, seasonKey, milestone])
  @@index([userId, claimedAt])
}

/// Recompensa de un logro ya cobrada. El catálogo vive en código
/// (`ACHIEVEMENTS`); acá solo se marca el cobro one-shot por id.
model AchievementClaim {
  userId        String
  achievementId String
  claimedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId, claimedAt])
}

/// Auditoría de entregas. Permite investigar un reclamo duplicado, una
/// recompensa que no llegó o una diferencia de saldo sin reconstruirlo desde
/// los logs. `payload` guarda las recompensas resueltas por el servidor.
model RewardLedger {
  id        String   @id @default(cuid())
  userId    String
  source    String // "daily" | "weekly" | "event_mission" | "pvp" | "achievement" | "tower"
  sourceRef String // "cycle-28:12" | "2026-W31:50" | "water-fest:catch-10" | "firstSteps"
  payload   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Progreso individual de la incursión cooperativa que rota cada semana.
/// El total de la comunidad y el ranking se derivan sumando estas filas.
model WeeklyRaidScore {
  userId          String
  weekKey         String
  bossSpeciesId   Int
  attemptsUsed    Int       @default(0)
  totalDamage     Int       @default(0)
  bestDamage      Int       @default(0)
  rewardClaimedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekKey])
  @@index([weekKey, totalDamage])
  @@index([weekKey, bossSpeciesId])
}

// ---------- Torre de Combate ----------
// Contenido estático en src/lib/tower/; acá solo progreso e intentos.

enum TowerRunStatus {
  ACTIVE
  AWAITING_BLESSING
  RESTING
  FAILED
  COMPLETED
  ABANDONED
}

// ---------- Fábrica de Combate ----------
// Los Pokémon de alquiler son snapshots JSON: no son capturas del jugador y
// nunca crean PokemonInstance ni entradas de Pokédex.

enum FactoryRunStatus {
  DRAFTING
  ACTIVE
  AWAITING_SWAP
  WON
  LOST
}

model FactoryRun {
  id              String           @id @default(cuid())
  userId          String
  dayKey          String
  status          FactoryRunStatus @default(DRAFTING)
  /// Cantidad de combates ganados (0..7).
  round           Int              @default(0)
  draftPool       Json
  team            Json             @default("[]")
  lastOpponent    Json             @default("[]")
  battleHistory   Json             @default("[]")
  totalTurns      Int              @default(0)
  pointsAwarded   Int              @default(0)
  rewardClaimedAt DateTime?
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([dayKey, round, totalTurns])
  @@index([userId, status])
}

/// Progreso permanente + de temporada por torre/dificultad.
model TowerProgress {
  id                  String   @id @default(cuid())
  userId              String
  towerId             String
  difficultyId        String
  highestFloorAllTime Int      @default(0)
  highestFloorSeason  Int      @default(0)
  seasonKey           String
  claimedFirstClears  String[] @default([])
  guardiansDefeated   Int      @default(0)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, towerId, difficultyId])
  @@index([userId])
}

/// Intento / ascenso en curso o cerrado.
model TowerRun {
  id                   String         @id @default(cuid())
  userId               String
  towerId              String
  difficultyId         String
  status               TowerRunStatus @default(ACTIVE)
  currentFloor         Int            @default(1)
  /// Snapshot del equipo del intento (HP/PP/derrotados + restore de Aventura).
  teamSnapshot         Json
  /// Si no es null, el ascenso está pausado: Aventura restaurada, se puede salir de /tower.
  parkedAt             DateTime?
  /// Botín acumulado del ascenso, pendiente de reclamar al cerrar.
  pendingLoot          Json           @default("[]")
  lootClaimedAt        DateTime?
  blessingIds          String[]       @default([])
  offeredBlessingIds   String[]       @default([])
  teamChangesRemaining Int            @default(1)
  attemptsConsumed     Int            @default(1)
  startedAt            DateTime       @default(now())
  endedAt              DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleSessions BattleSession[]

  @@index([userId, status])
  @@index([userId, towerId, difficultyId])
}

/// Contador de intentos por período de Torre (dayKey = towerPeriodKey semanal).
model TowerAttemptDay {
  id           String @id @default(cuid())
  userId       String
  dayKey       String
  attemptsUsed Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId])
}

// ---------- Expediciones Safari ----------
// Corridas semanales de captura sin combate, energía ni objetos de la mochila.

enum SafariRunStatus {
  ACTIVE
  COMPLETED
}

model SafariRun {
  id                 String          @id @default(cuid())
  userId             String
  weekKey            String
  biomeId            String
  status             SafariRunStatus @default(ACTIVE)
  encountersUsed     Int             @default(0)
  seenSpeciesIds     Int[]           @default([])
  ballsRemaining     Int             @default(15)
  encounterSpeciesId Int?
  encounterLevel     Int?
  encounterIsShiny   Boolean         @default(false)
  bestScore          Int             @default(0)
  bestSpeciesId      Int?
  bestLevel          Int?
  bestIsShiny        Boolean         @default(false)
  catches            Int             @default(0)
  rewardCoins        Int             @default(0)
  rewardGems         Int             @default(0)
  startedAt          DateTime        @default(now())
  endedAt            DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  encounterSpecies Species?      @relation("SafariEncounterSpecies", fields: [encounterSpeciesId], references: [id])
  bestSpecies      Species?      @relation("SafariBestSpecies", fields: [bestSpeciesId], references: [id])
  captured         SafariCatch[]

  @@index([userId, status])
  @@index([userId, weekKey])
  @@index([weekKey, bestScore])
}

model SafariCatch {
  id                String   @id @default(cuid())
  runId             String
  pokemonInstanceId String?  @unique
  speciesId         Int
  level             Int
  isShiny           Boolean  @default(false)
  score             Int
  caughtAt          DateTime @default(now())

  run             SafariRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  pokemonInstance PokemonInstance? @relation(fields: [pokemonInstanceId], references: [id], onDelete: SetNull)
  species         Species          @relation(fields: [speciesId], references: [id])

  @@index([runId, score])
  @@index([speciesId])
}

// ---------- Guerras de clan (v1) ----------
// Temporada mensual (misma clave YYYY-MM que PvP). Registro → empareje →
// N slots de combate rápido (simulación) → score y Elo de clan.

enum ClanWarSeasonStatus {
  REGISTRATION
  ACTIVE
  SETTLED
}

enum ClanWarStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ClanWarBattleStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  FORFEIT
}

model ClanWarSeason {
  id        String              @id @default(cuid())
  seasonKey String              @unique
  status    ClanWarSeasonStatus @default(ACTIVE)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime            @default(now())

  registrations ClanWarRegistration[]
  wars          ClanWar[]
}

model ClanWarRegistration {
  id        String   @id @default(cuid())
  seasonId  String
  clanId    String
  rating    Int      @default(1000)
  /// Snapshot de userIds al registrarse (roster elegible).
  roster    Json
  createdAt DateTime @default(now())

  season ClanWarSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clan   Clan          @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([seasonId, clanId])
  @@index([seasonId])
}

model ClanWar {
  id            String        @id @default(cuid())
  seasonId      String
  clanAId       String
  clanBId       String
  status        ClanWarStatus @default(ACTIVE)
  scoreA        Int           @default(0)
  scoreB        Int           @default(0)
  ratingABefore Int
  ratingBBefore Int
  ratingAAfter  Int?
  ratingBAfter  Int?
  matchedAt     DateTime      @default(now())
  completedAt   DateTime?

  season  ClanWarSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clanA   Clan            @relation("ClanWarA", fields: [clanAId], references: [id], onDelete: Cascade)
  clanB   Clan            @relation("ClanWarB", fields: [clanBId], references: [id], onDelete: Cascade)
  battles ClanWarBattle[]

  @@index([seasonId, status])
  @@index([clanAId, status])
  @@index([clanBId, status])
}

model ClanWarBattle {
  id             String              @id @default(cuid())
  warId          String
  slot           Int
  fighterAId     String?
  fighterBId     String?
  status         ClanWarBattleStatus @default(OPEN)
  /// Clan ganador del slot (clanAId o clanBId del war).
  winnerClanId   String?
  winnerUserId   String?
  /// Snapshots PvP (misma forma que PvpMatch) para pelea interactiva / sim.
  challengerTeam Json                @default("[]")
  opponentTeam   Json                @default("[]")
  /// Quién inició el combate (humano en /battle); null si fue sim bot.
  startedById    String?
  koLog          Json                @default("[]")
  completedAt    DateTime?

  war           ClanWar        @relation(fields: [warId], references: [id], onDelete: Cascade)
  fighterA      User?          @relation("ClanWarFighterA", fields: [fighterAId], references: [id], onDelete: SetNull)
  fighterB      User?          @relation("ClanWarFighterB", fields: [fighterBId], references: [id], onDelete: SetNull)
  battleSession BattleSession?

  @@unique([warId, slot])
  @@index([warId, status])
}

// ---------- Parque (pensión, trueque, huerto, mina, recinto) ----------
// Timers lazy como la energía: se leen al abrir, no hay cron.

model DaycareDeposit {
  id                String   @id @default(cuid())
  userId            String
  slot              Int
  pokemonInstanceId String   @unique
  depositedAt       DateTime @default(now())
  lastCollectedAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId])
}

model WonderTradeOffer {
  id                String    @id @default(cuid())
  userId            String
  pokemonInstanceId String    @unique
  createdAt         DateTime  @default(now())
  matchedAt         DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  @@index([matchedAt, createdAt])
  @@index([userId, matchedAt])
}

/**
 * Trueque 1:1 entre amigos. El Pokémon ofertado queda reservado (PC) hasta
 * que el destinatario responde con uno suyo o alguien cancela.
 */
model FriendTradeOffer {
  id                String   @id @default(cuid())
  fromUserId        String
  toUserId          String
  pokemonInstanceId String   @unique
  createdAt         DateTime @default(now())

  from    User            @relation("FriendTradeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to      User            @relation("FriendTradeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)

  @@index([toUserId, createdAt])
  @@index([fromUserId])
}

model BerryPlot {
  userId      String
  slot        Int
  berryItemId String?
  plantedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  berry Item? @relation(fields: [berryItemId], references: [id], onDelete: SetNull)

  @@id([userId, slot])
}

model ParkMine {
  userId    String   @id
  dayKey    String
  grid      Json
  bag       Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParkCorner {
  userId    String   @id
  dayKey    String
  spins     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cupo diario de la caña: los primeros lances del día son gratis.
model ParkFishing {
  userId    String   @id
  dayKey    String
  casts     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cupo diario del laboratorio: los primeros trueques del día son gratis.
model ParkWonder {
  userId    String   @id
  dayKey    String
  trades    Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Fragmentos de una especie ganados en minijuegos (pesca, mina).
/// A los `FRAGMENTS_TO_ASSEMBLE` (10) se arma el Pokémon.
model SpeciesFragment {
  userId    String
  speciesId Int
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([userId, speciesId])
  @@index([userId])
}

model FrontierAttempt {
  userId    String
  facility  String
  dayKey    String
  streak    Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  lastWon   Boolean  @default(false)
  lastLog   Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, facility, dayKey])
}
