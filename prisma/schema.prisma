// Pokemon-like RPG — ver dossier de diseño para el porqué de cada decisión.
// Efectividad de tipos NO vive acá: son 18 tipos fijos, se cachean como
// constante en código desde PokeAPI (prisma no es el lugar para eso).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Cuenta y economía ----------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  country         String // ISO-3166 alpha-2, define el segmento del ranking
  locale          String   @default("es")
  gender          String? // "male" | "female" | "unspecified", opcional — puro perfil, sin efecto en mecánicas
  age             Int? // opcional
  avatarId        String? // referencia a AVATAR_OPTIONS en src/lib/avatars.ts, no una imagen — null = iniciales (comportamiento actual)
  coins           Int      @default(0)
  /// Moneda premium (gemas) — reservada para usos de PC / economía especial.
  gems            Int      @default(0)
  energy          Int      @default(20)
  energyMax       Int      @default(20)
  energyUpdatedAt DateTime @default(now()) // para calcular regeneración sin cron
  lastHealAt      DateTime? // Centro Pokémon: la curación gratis tiene cooldown; pagar lo saltea
  createdAt       DateTime @default(now())

  // Ladder PvP (dossier fase 4). Rating Elo + récord; segmento del ranking PvP.
  pvpRating Int @default(1000)
  pvpWins   Int @default(0)
  pvpLosses Int @default(0)

  pokemon         PokemonInstance[]
  inventory       InventoryItem[]
  gymAttempts     GymAttempt[]
  gymRuns         GymRun[]
  badges          Badge[]
  listingsSold    MarketListing[]   @relation("Seller")
  listingsBought  MarketListing[]   @relation("Buyer")
  clanMembership  ClanMember?
  ledClan         Clan?             @relation("ClanLeader")
  battlesAsUser   BattleLog[]       @relation("BattleUser")
  battlesAsOpp    BattleLog[]       @relation("BattleOpponent")
  battleSessions  BattleSession[]
  pvpAsChallenger PvpMatch[]        @relation("PvpChallenger")
  pvpAsOpponent   PvpMatch[]        @relation("PvpOpponent")
  campaignProgress CampaignProgress?
  eggs         Egg[]
  clanMessages ClanMessage[]
  notifications Notification[]
  pokedexEntries PokedexEntry[]
  zoneMastery  ZoneMastery[]
  seenSpecies  SeenSpecies[]
  trainerDefeats TrainerDefeat[]
  objectiveClaims ZoneObjectiveClaim[]
}

// ---------- Notificaciones in-app ----------
// Historial de avisos (mercado, gimnasios, PvP). El payload es JSON tipado
// por `type` — la UI traduce con next-intl, no se guardan strings localizados.

enum NotificationType {
  MARKET_SOLD
  MARKET_EXPIRED
  GYM_WON
  GYM_LOST
  GYM_TM_REWARD
  PVP_WON
  PVP_LOST
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// Datos para interpolar el mensaje (buyerName, itemName, coins, gymName…).
  payload   Json             @default("{}")
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------- Progresión de campaña (Region → Location → Stage) ----------
// Contenido estático en src/lib/campaign/; acá solo el progreso del jugador.
// PvP no lee ni escribe este modelo.

model CampaignProgress {
  userId                    String   @id
  currentRegionId           String   @default("kanto")
  highestUnlockedLocationId String
  selectedLocationId        String
  farmingLocationId         String
  farmingStageId            String
  highestCompletedStageId   String?
  completedStageIds         String[] @default([])
  lastMilestoneId           String?
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Datos de Pokémon (seed desde PokeAPI, ver scripts/seed) ----------

model Species {
  id            Int       @id // pokedex id, mismo que en PokeAPI
  name          String    @unique
  types         String[] // 1 o 2 tipos, ej. ["fire"] o ["grass", "poison"]
  baseHp        Int
  baseAttack    Int
  baseDefense   Int
  baseSpAtk     Int
  baseSpDef     Int
  baseSpeed     Int
  spriteUrl     String
  generation    Int
  captureRate   Int       @default(45) // 0-255, de PokeAPI — más alto = más fácil de atrapar
  // Nivel mínimo para evolucionar por level-up a evolvesTo[0]. Null = no evoluciona por nivel
  // (piedra, intercambio, etc.) o es la forma final.
  evolveLevel   Int?
  // Cómo se llega a ESTA especie desde su pre-evolución. Vive del lado del hijo
  // porque el padre puede tener varias evoluciones con requisitos distintos
  // (Eevee → Vaporeon/Jolteon/Flareon, una piedra cada una) y `evolveLevel`,
  // que vive en el padre, no puede representarlas.
  evolveTrigger String? // "level-up" | "use-item" | "trade" | "shed" ...
  evolveItem    String? // nombre del ítem tal cual está en `Item.name`, ej. "Water Stone"
  evolveMinLevel Int? // nivel mínimo del trigger, cuando aplica
  evolvesFromId Int?
  evolvesFrom   Species?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo     Species[] @relation("Evolution")

  learnableMoves    SpeciesMove[]
  instances         PokemonInstance[]
  battleSessions    BattleSession[]
  gymPokemon        GymPokemon[]
  gymTrainerPokemon GymTrainerPokemon[]
  eggs              Egg[]
  pokedexEntries    PokedexEntry[]
  seenBy            SeenSpecies[]
}

enum MoveCategory {
  PHYSICAL
  SPECIAL
  STATUS
}

model Move {
  id         Int          @id // move id de PokeAPI
  name       String       @unique
  type       String
  category   MoveCategory
  power      Int? // null para movimientos de estado
  accuracy   Int? // null = nunca falla
  pp         Int
  priority   Int          @default(0)
  effectText String?

  learnableBy SpeciesMove[]
  knownBy     PokemonMove[]
  teachableAs Item[] // MTs/MOs que enseñan este movimiento (type=MACHINE)
}

enum LearnMethod {
  LEVEL_UP
  MACHINE
}

// Compatibilidad real especie↔movimiento — un mismo par puede existir dos
// veces con method distinto (aprende por nivel Y por MT), como en los
// juegos reales. learnLevel solo tiene sentido para LEVEL_UP.
model SpeciesMove {
  speciesId  Int
  moveId     Int
  method     LearnMethod @default(LEVEL_UP)
  /** Null en MT/tutor/huevo: esos movimientos no se aprenden por nivel. */
  learnLevel Int?

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@id([speciesId, moveId, method])
}

// ---------- Pokémon de un jugador ----------

model PokemonInstance {
  id        String   @id @default(cuid())
  ownerId   String
  speciesId Int
  nickname  String?
  level     Int      @default(5)
  xp        Int      @default(0)
  currentHp Int
  isShiny   Boolean  @default(false)
  teamSlot  Int? // 1-6 = en equipo activo, null = en almacenamiento (PC)
  /// Destacado del entrenador (emblema de ranking); independiente del slot.
  isFavorite Boolean @default(false)
  /// Si true, no se puede publicar en el mercado.
  isTradeLocked Boolean @default(false)
  caughtAt  DateTime @default(now())

  // Puntos manuales por Pokémon — el diferenciador de diseño del proyecto.
  // Ver dossier: reemplaza EV/IV por progresión que controla el jugador.
  unspentPoints  Int @default(0)
  ptStrength     Int @default(0) // ataque
  ptSpeed        Int @default(0) // orden de turnos
  ptDexterity    Int @default(0) // defensa
  ptIntelligence Int @default(0) // desbloquea movimientos + xp
  ptConstitution Int @default(0) // HP

  // Objeto equipado (Leftovers, Choice Band, etc.) — efecto real en batalla,
  // no decorativo. Ver Item.heldEffect/heldValue.
  heldItemId String?
  heldItem   Item?   @relation(fields: [heldItemId], references: [id])

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species        Species         @relation(fields: [speciesId], references: [id])
  moves          PokemonMove[]
  listings       MarketListing[]
  battleSessions BattleSession[]

  @@unique([ownerId, teamSlot]) // dos Pokémon no pueden compartir slot. Postgres
  // trata cada NULL como distinto, así que el PC (teamSlot null) no se ve afectado.
  @@index([ownerId])
  @@index([speciesId])
  @@index([ownerId, isFavorite])
}

/// Entrada de Pokédex: el entrenador vio la especie (encuentro, batalla, etc.).
/// Capturado se deriva de PokemonInstance — no se duplica acá.
model PokedexEntry {
  userId    String
  speciesId Int
  seenAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([userId, speciesId])
  @@index([userId, seenAt])
}

// Cría: dos padres del jugador producen un huevo que hereda parte de los puntos
// invertidos. Es un sumidero de economía y le da uso a los que no pelean.
model Egg {
  id           String   @id @default(cuid())
  ownerId      String
  speciesId    Int
  parentAId    String
  parentBId    String
  /** Puntos heredados que arranca la cría — mismos 5 atributos que la instancia. */
  ptStrength     Int @default(0)
  ptSpeed        Int @default(0)
  ptDexterity    Int @default(0)
  ptIntelligence Int @default(0)
  ptConstitution Int @default(0)
  isShiny      Boolean  @default(false)
  readyAt      DateTime // eclosiona con el tiempo, como la energía: sin cron
  hatchedAt    DateTime?
  createdAt    DateTime @default(now())

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@index([ownerId, hatchedAt])
}

model PokemonMove {
  pokemonInstanceId String
  moveId            Int
  slot              Int // 1-4
  currentPp         Int    @default(0) // se setea al aprender; 0 se trata como "lleno" hasta la 1ª batalla

  pokemon PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)
  move    Move            @relation(fields: [moveId], references: [id])

  @@id([pokemonInstanceId, slot])
}

// ---------- Gimnasios y medallas ----------

model Gym {
  id            String @id @default(cuid())
  order         Int    @unique // orden secuencial fijo, 1..N — desbloquea al tener la medalla del anterior
  name          String
  leaderName    String
  badgeName     String @default("") // nombre real de la medalla (ej. "Boulder Badge")
  type          String // tipo principal del líder — define el ícono/color de la medalla
  cooldownHours Int    @default(24) // solo aplica tras perder una batalla (no al abandonar la corrida)
  opensHour     Int    @default(0) // horario de atención en hora local del jugador (0-23).
  closesHour    Int    @default(24) // 0/24 = abierto siempre. Si closes <= opens, cruza la medianoche.
  coinReward    Int    @default(100)
  /** Alto Mando / Campeón: no cuenta como medalla y solo se abre con las 8. */
  isElite       Boolean @default(false)

  team           GymPokemon[]
  trainers       GymTrainer[]
  runs           GymRun[]
  attempts       GymAttempt[]
  badges         Badge[]
  battleSessions BattleSession[]
  battleLogs     BattleLog[]
}

// Equipo fijo del líder — no es un PokemonInstance real (no evoluciona, no
// tiene puntos manuales), mismo criterio que el Pokémon salvaje efímero.
model GymPokemon {
  id        String @id @default(cuid())
  gymId     String
  speciesId Int
  level     Int
  slot      Int // orden en el equipo del líder, 1..N

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@unique([gymId, slot])
}

// Entrenadores subordinados que hay que vencer en orden antes de desbloquear
// al líder — genéricos (no personajes con nombre propio de los juegos
// oficiales), equipo más chico y débil que el del líder, mismo tipo temático.
model GymTrainer {
  id    String @id @default(cuid())
  gymId String
  slot  Int // orden dentro del gimnasio, 1..N, antes del líder
  name  String

  gym            Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  team           GymTrainerPokemon[]
  battleSessions BattleSession[]

  @@unique([gymId, slot])
}

model GymTrainerPokemon {
  id           String @id @default(cuid())
  gymTrainerId String
  speciesId    Int
  level        Int
  slot         Int

  gymTrainer GymTrainer @relation(fields: [gymTrainerId], references: [id], onDelete: Cascade)
  species    Species    @relation(fields: [speciesId], references: [id])

  @@unique([gymTrainerId, slot])
}

enum GymRunStatus {
  ACTIVE
  WON
  ABANDONED
}

// Un intento de gimnasio: agrupa la secuencia entrenadores→líder de una
// corrida. Si se abandona (botón de salida) o se pierde una batalla dentro
// de la corrida, se marca ABANDONED — la próxima vez se empieza desde el
// entrenador 1 de nuevo, no se retoma donde quedó.
model GymRun {
  id                  String       @id @default(cuid())
  userId              String
  gymId               String
  status              GymRunStatus @default(ACTIVE)
  clearedTrainerSlots Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  battleSessions BattleSession[]

  @@index([userId, gymId, status])
}

model GymAttempt {
  id          String   @id @default(cuid())
  userId      String
  gymId       String
  attemptedAt DateTime @default(now())
  won         Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([userId, gymId])
}

model Badge {
  id       String   @id @default(cuid())
  userId   String
  gymId    String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([userId, gymId])
}

enum StatusCondition {
  BURN
  PARALYSIS
  POISON
  SLEEP
}

// ---------- Economía: objetos y mercado ----------

enum ItemType {
  BERRY
  EVOLUTION_STONE
  POKEBALL
  POTION
  MACHINE
  HELD
}

// Efecto mecánico real de un objeto equipable en batalla — mismo criterio
// que SpeciesMove.method: el dato vive en el ítem, no se hardcodea por nombre.
enum HeldEffect {
  LEFTOVERS // cura heldValue% del HP máx al final del propio turno
  CHOICE_LOCK // heldValue× a heldStat, bloquea el movimiento tras el primer uso
  LIFE_ORB // +heldValue% de poder, retroceso 10% HP máx en golpes que dañan
  FOCUS_SASH // sobrevive con 1 HP un golpe que lo KOtearía desde HP máximo (un solo uso)
  EVIOLITE // +heldValue% def/def.esp si la especie no evolucionó del todo
  FLINCH_CHANCE // heldValue de probabilidad de que el rival no pueda moverse ese turno
  QUICK_CLAW // heldValue de probabilidad de actuar primero (misma prioridad)
  SITRUS_BERRY // cura heldValue% del HP máx una vez, al cruzar 50% HP (un solo uso)
  LUM_BERRY // cura cualquier estado alterado apenas se aplica (un solo uso)
  TYPE_BOOST // +heldValue% de poder en movimientos de tipo heldBoostType
}

model Item {
  id              String      @id @default(cuid())
  name            String      @unique
  type            ItemType
  effectText      String?
  buyPrice        Int
  catchMultiplier Float? // solo para type=POKEBALL (null = no aplica). Master Ball usa un valor
  // altísimo (255) para que la fórmula de captura dé siempre "atrapado".
  healAmount      Int? // solo para type=POTION (null = no aplica). Full Restore usa un valor
  // altísimo (9999) para que la curación quede siempre acotada al HP máximo.
  moveId          Int? // solo para type=MACHINE (null = no aplica) — el movimiento que enseña
  move            Move?       @relation(fields: [moveId], references: [id])
  heldEffect      HeldEffect? // objeto equipable con efecto real en batalla (no aplica a todos los tipos)
  heldValue       Float? // magnitud genérica: multiplicador, % de HP o probabilidad según heldEffect
  heldStat        String? // "atk" | "spAtk" | "speed" — solo CHOICE_LOCK
  heldBoostType   String? // tipo de movimiento potenciado — solo TYPE_BOOST

  inventoryOf InventoryItem[]
  holders     PokemonInstance[]
}

model InventoryItem {
  userId   String
  itemId   String
  quantity Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

enum ListingKind {
  POKEMON
  ITEM
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

model MarketListing {
  id                String        @id @default(cuid())
  sellerId          String
  kind              ListingKind
  // Solo si kind = POKEMON. No es @unique: un Pokémon puede tener varias
  // publicaciones históricas (SOLD/CANCELLED/EXPIRED). La regla "una sola
  // ACTIVE por Pokémon" la garantiza el lock de fila del vendedor que toman
  // las transacciones del mercado — ver src/lib/db-locks.ts.
  pokemonInstanceId String?
  itemId            String? // solo si kind = ITEM
  quantity          Int? // solo si kind = ITEM
  price             Int
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  // Se setea al crear (ahora + TTL). Null solo en filas anteriores a la
  // feature — esas no expiran. La expiración es lazy: se barre al cargar
  // el mercado, no hay cron.
  expiresAt         DateTime?
  buyerId           String?
  soldAt            DateTime?
  // Null = el vendedor todavía no vio el desenlace (vendido / expirado). Se
  // usa para el contador de novedades de "Mis publicaciones": sin esto, una
  // publicación que vence se devuelve al PC en silencio.
  sellerSeenAt      DateTime?
  // Null = el comprador todavía no retiró el bien de la mochila del mercado.
  // Hasta reclamar: ítems no entran al inventario; Pokémon quedan en escrow
  // del comprador (ocultos del PC).
  buyerClaimedAt    DateTime?

  seller  User             @relation("Seller", fields: [sellerId], references: [id])
  buyer   User?            @relation("Buyer", fields: [buyerId], references: [id])
  pokemon PokemonInstance? @relation(fields: [pokemonInstanceId], references: [id])

  @@index([status, kind])
  @@index([pokemonInstanceId])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([buyerId, status, buyerClaimedAt])
  @@index([status, expiresAt]) // barrido de vencidas
}

// ---------- Clanes ----------

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

model Clan {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String   @unique // 3-5 caracteres, se muestra junto al nombre
  leaderId  String   @unique
  createdAt DateTime @default(now())

  leader   User          @relation("ClanLeader", fields: [leaderId], references: [id])
  members  ClanMember[]
  messages ClanMessage[]
}

model ClanMember {
  userId   String   @id
  clanId   String
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

model ClanMessage {
  id        String   @id @default(cuid())
  clanId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
}

/**
 * Experiencia del jugador en una zona concreta.
 *
 * Es lo que hace que volver a una zona ya completada siga teniendo sentido:
 * sube con cada victoria salvaje ahí y otorga bonus permanentes de XP, captura
 * y monedas en esa zona.
 */
model ZoneMastery {
  userId     String
  locationId String
  xp         Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
}

/**
 * Qué especies vio el jugador en cada zona.
 *
 * Habilita el descubrimiento progresivo: la Pokédex de la zona arranca en
 * silueta desconocida y se va revelando al cruzarse cada especie, en vez de
 * mostrar de entrada todo lo que puede aparecer.
 */
model SeenSpecies {
  userId     String
  locationId String
  speciesId  Int
  seenAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id])

  @@id([userId, locationId, speciesId])
  @@index([userId, locationId])
}

/** A qué entrenadores de ruta ya venciste. Los entrenadores son estáticos. */
model TrainerDefeat {
  userId     String
  trainerId  String
  locationId String
  defeatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, trainerId])
  @@index([userId, locationId])
}

/** Recompensas de objetivo de zona ya cobradas. */
model ZoneObjectiveClaim {
  userId     String
  locationId String
  objective  String // stages | pokedex | trainers — ver objectives.ts
  claimedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationId, objective])
  @@index([userId])
}

// ---------- Batallas (historial — el ranking se calcula a partir de esto) ----------

enum BattleKind {
  PVE_WILD
  PVE_GYM
  PVP
}

model BattleLog {
  id         String     @id @default(cuid())
  kind       BattleKind
  userId     String
  opponentId String? // null si es PVE
  gymId      String?
  userWon    Boolean
  createdAt  DateTime   @default(now())

  user     User  @relation("BattleUser", fields: [userId], references: [id], onDelete: Cascade)
  opponent User? @relation("BattleOpponent", fields: [opponentId], references: [id])
  gym      Gym?  @relation(fields: [gymId], references: [id])

  @@index([userId])
}

// Batalla PvE en curso — se resuelve turno a turno vía Server Actions.
// El Pokémon salvaje no es un PokemonInstance real, es efímero: su HP y
// movimientos viven solo acá mientras dura el combate.
enum BattleSessionStatus {
  ACTIVE
  WON
  LOST
  FLED
  CAUGHT
}

model BattleSession {
  id                String              @id @default(cuid())
  userId            String
  pokemonInstanceId String
  wildSpeciesId     Int
  wildLevel         Int
  wildCurrentHp     Int
  wildMaxHp         Int
  wildMoveIds       Int[]
  wildMovePp        Int[]               @default([]) // PP restante paralelo a wildMoveIds
  wildIsShiny       Boolean             @default(false)
  routeTrainerId    String? // entrenador de ruta (datos estáticos, ver trainers.ts) // se tira al generar el encuentro para que se vea variante en combate
  status            BattleSessionStatus @default(ACTIVE)
  log               String[]            @default([])
  participantIds    String[]            @default([]) // todos los Pokémon del jugador que pelearon en esta sesión (para repartir XP al terminar)
  pendingXp         Int                 @default(0) // XP acumulada de KOs previos en la misma sesión, pendiente de repartir al terminar
  gymId             String? // null = encuentro salvaje. Si tiene valor, wildSpecies/wildLevel/etc.
  // reflejan al oponente ACTUAL (entrenador subordinado o líder), no uno efímero random.
  gymRunId          String? // corrida de gimnasio a la que pertenece esta batalla (null = encuentro salvaje)
  gymTrainerId      String? // entrenador subordinado actual — null = está peleando contra el líder
  gymPokemonSlot    Int? // slot del equipo actual (del entrenador o del líder) que se está peleando
  // Estado de combate en sesión (se limpia al cambiar de Pokémon / fin de batalla).
  playerStatus      StatusCondition?
  wildStatus        StatusCondition?
  playerSleepTurns  Int                 @default(0)
  wildSleepTurns    Int                 @default(0)
  playerAtkStage    Int                 @default(0)
  playerDefStage    Int                 @default(0)
  playerSpeStage    Int                 @default(0)
  wildAtkStage      Int                 @default(0)
  wildDefStage      Int                 @default(0)
  wildSpeStage      Int                 @default(0)
  fleeAttempts      Int                 @default(0) // fallos de huida; sube la chance (Gen III)
  // Objeto equipado del jugador (fijo para toda la batalla, no se puede
  // cambiar en combate — ver blockIfInCombat en equip-held-item).
  playerChoiceLockMoveId Int? // si porta un objeto CHOICE_LOCK, el movimiento al que quedó atado
  playerItemConsumed     Boolean @default(false) // FOCUS_SASH/SITRUS/LUM ya se gastaron esta batalla
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemonInstance PokemonInstance @relation(fields: [pokemonInstanceId], references: [id], onDelete: Cascade)
  wildSpecies     Species         @relation(fields: [wildSpeciesId], references: [id])
  gym             Gym?            @relation(fields: [gymId], references: [id])
  gymRun          GymRun?         @relation(fields: [gymRunId], references: [id])
  gymTrainer      GymTrainer?     @relation(fields: [gymTrainerId], references: [id])

  @@index([userId, status])
}

// ---------- PvP ----------

// Partido PvP ya resuelto (simulación server-authoritative). Guarda el
// resultado, la cadena de KOs para reconstruir la narrativa y los ratings
// antes/después de ambos lados para poder mostrar el delta.
model PvpMatch {
  id                     String   @id @default(cuid())
  challengerId           String
  opponentId             String
  winnerId               String // challengerId u opponentId
  challengerRatingBefore Int
  challengerRatingAfter  Int
  opponentRatingBefore   Int
  opponentRatingAfter    Int
  koLog                  String[] @default([]) // "ladoNombre>ladoNombre" por KO
  turns                  Int      @default(0)
  createdAt              DateTime @default(now())

  challenger User @relation("PvpChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("PvpOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, createdAt])
  @@index([opponentId, createdAt])
}
